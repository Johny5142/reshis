# На сервере включить после настройки HTTPS.
COOKIE_SECURE=true
# Точный публичный origin, без завершающего слеша. Для локального HTTP
# COOKIE_SECURE=false; по умолчанию разрешены localhost/127.0.0.1:5173 и :8000.
AUTH_TRUSTED_ORIGINS=https://YOUR_SUBDOMAIN.duckdns.org
# IP доверенного reverse proxy, видимый из контейнера API. Не задавайте *.
# Заполните адрес после проверки сети на сервере. Compose требует значение.
FORWARDED_ALLOW_IPS=
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_EMAIL_LIMIT=20
AUTH_REGISTER_IP_LIMIT=20
AUTH_REGISTER_EMAIL_LIMIT=5
AUTH_RATE_MAX_KEYS=10000
